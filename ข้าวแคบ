    frame.Size = UDim2.new(1, 0, 0, 44)
    frame.BackgroundColor3 = THEME.card
    frame.BorderSizePixel = 0
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
    local s = Instance.new("UIStroke", frame)
    s.Color = THEME.cardStroke
    s.Thickness = 1.5

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -78, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = THEME.textDark
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 52, 0, 26)
    switch.Position = UDim2.new(1, -64, 0.5, -13)
    switch.BackgroundColor3 = THEME.toggleOff
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = frame
    Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.Position = UDim2.new(0, 2, 0.5, -11)
    knob.BackgroundColor3 = THEME.knob
    knob.Parent = switch
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local kStroke = Instance.new("UIStroke", knob)
    kStroke.Color = THEME.stroke
    kStroke.Thickness = 1

    local state = defaultValue or false
    local function update()
        switch.BackgroundColor3 = state and THEME.toggleOn or THEME.toggleOff
        knob.Position = state and UDim2.new(1, -24, 0.5, -11) or UDim2.new(0, 2, 0.5, -11)
    end
    update()

    switch.MouseButton1Click:Connect(function()
        state = not state
        update()
        if callback then callback(state) end
    end)
end

