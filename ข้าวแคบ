-- ===== AutoCollect =====
local AC_ENABLED = false
local SCAN_TICK, MAX_DISTANCE, MAX_PER_PASS, PASSES_PER_TICK, PROMPT_COOLDOWN = 0.03, 150, 50, 3, 0.15
local lastScan = 0
local promptCooldown, cachedPrompts, farm = {}, {}, nil

local function getMyFarm()
    if farm and farm.Parent then return farm end
    local f = Workspace:FindFirstChild("Farm")
    if not f then return end
    for _, fm in ipairs(f:GetChildren()) do
        if fm:GetAttribute("OwnerId") == LocalPlayer.UserId then
            farm = fm
            return fm
        end
    end
end

local function getPos()
    local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    return h and h.Position
end

local function firePrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local now = os.clock()
    local last = promptCooldown[prompt]
    if last and (now - last) < PROMPT_COOLDOWN then return false end
    promptCooldown[prompt] = now
    pcall(function()
        local orig = prompt.HoldDuration
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        prompt:InputHoldEnd()
        prompt.HoldDuration = orig
    end)
    return true
end

local function addPrompt(prompt)
    local part = prompt.Parent
    if part and part:IsA("BasePart") then
        table.insert(cachedPrompts, { prompt = prompt, part = part })
    end
end

local function rebuildCache()
    cachedPrompts = {}
    local f = getMyFarm()
    if not f then return end
    for _, obj in ipairs(f:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Name == "ProductPrompt" then
            addPrompt(obj)
        end
    end
end

local function onePass(pos)
    local count = 0
    for i = 1, #cachedPrompts do
        local e = cachedPrompts[i]
        local prompt, part = e.prompt, e.part
        if prompt.Parent and prompt.Enabled and part.Parent then
            local dx, dy, dz = part.Position.X - pos.X, part.Position.Y - pos.Y, part.Position.Z - pos.Z
            if (dx*dx + dy*dy + dz*dz) <= MAX_DISTANCE * MAX_DISTANCE and firePrompt(prompt) then
                count = count + 1
                if count >= MAX_PER_PASS then break end
            end
        end
    end
    return count
end

local function burstScan()
    if not AC_ENABLED then return end
    local pos = getPos()
    if not pos then return end
    for _ = 1, PASSES_PER_TICK do
        if onePass(pos) == 0 then break end
    end
    local now = os.clock()
    for p, t in pairs(promptCooldown) do
        if not p.Parent or (now - t) > 5 then promptCooldown[p] = nil end
    end
end

local function hookFarm()
    local f = getMyFarm()
    if not f then return end
    f.DescendantAdded:Connect(function(obj)
        if obj:IsA("ProximityPrompt") and obj.Name == "ProductPrompt" then addPrompt(obj) end
    end)
    f.DescendantRemoving:Connect(function(obj)
        if obj:IsA("ProximityPrompt") then
            for i = #cachedPrompts, 1, -1 do
                if cachedPrompts[i].prompt == obj then table.remove(cachedPrompts, i) end
            end
        end
    end)
end

task.spawn(function()
    while not getMyFarm() do task.wait(1) end
    rebuildCache()
    hookFarm()
end)

RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if now - lastScan < SCAN_TICK then return end
    lastScan = now
    if AC_ENABLED then burstScan() end
end)

-- ===== AutoSell =====
local AS_ENABLED = false
local AS_CHECK_INTERVAL, AS_FULL_THRESHOLD = 2, 0.95
local isSelling = false

local function getMaxCapacity()
    local level = LocalPlayer:GetAttribute("FarmLevel") or 1
    local ok, BarnConfig = pcall(require, ReplicatedStorage.Modules.BarnConfig)
    if not ok then return 20 end
    local baseCap = (BarnConfig[level] or BarnConfig[1]).MaxInventoryCapacity or 20
    if LocalPlayer:GetAttribute("IsUnlimitedBackpack") then return math.huge end
    local mult = 1

    local extraLvl = LocalPlayer:GetAttribute("ExtraStorage_Level") or 0
    if extraLvl > 0 then
        local ok2, FM = pcall(require, ReplicatedStorage.Modules.FarmMasteryConfig)
        if ok2 and FM.Upgrades.ExtraStorage then
            mult = mult + ((FM.Upgrades.ExtraStorage.StatValues[extraLvl] or extraLvl * 3) / 100)
        else
            mult = mult + extraLvl * 0.03
        end
    end

    local storageLvl = LocalPlayer:GetAttribute("StorageExpansion_Level") or 0
    if storageLvl > 0 then mult = mult + storageLvl * 0.04 end

    local ok3, PetSkill = pcall(require, ReplicatedStorage.Modules.PetSkillConfig)
    if ok3 then
        local bonus = PetSkill.getPlayerStatBonus(LocalPlayer, "BackpackCapacity")
        if bonus > 0 then mult = mult + bonus / 100 end
    end

    if LocalPlayer:GetAttribute("IsBackpackSuper") then mult = mult * 1.5 end
    return math.floor(baseCap * mult)
end

local function getInventory()
    local ok, data = pcall(HttpService.JSONDecode, HttpService, LocalPlayer:GetAttribute("Inventory_JSON") or "{}")
    if not ok or type(data) ~= "table" then return 0, {} end
    local total = 0
    for _, c in pairs(data) do total = total + (tonumber(c) or 0) end
    return total, data
end

local function doSell(manual)
    if isSelling or LocalPlayer:GetAttribute("IsDelivering") then return end
    local current, data = getInventory()
    local maxCap = getMaxCapacity()

    if not manual and (maxCap == math.huge or current / math.max(maxCap, 1) < AS_FULL_THRESHOLD) then return end

    local items = {}
    for name, count in pairs(data) do
        if (tonumber(count) or 0) > 0 then items[name] = count end
    end
    if next(items) == nil then
        if manual then print("[AutoSell] ⚠️ กระเป๋าว่าง") end
        return
    end

    isSelling = true
    local ok, result = pcall(function()
        return ReplicatedStorage.RequestSendDelivery:InvokeServer(items)
    end)
    isSelling = false

    if ok and result then
        pcall(function()
            ReplicatedStorage.Remotes.GlobalNotification:Fire(string.format("🤖 ขายอัตโนมัติสำเร็จ (%d ชิ้น)", current), "Sukses")
        end)
        print(string.format("[AutoSell] ✅ ขาย %d ชิ้นสำเร็จ", current))
    else
        warn("[AutoSell] ❌ ขายไม่สำเร็จ")
    end
end

task.spawn(function()
    while not LocalPlayer:GetAttribute("DataLoadedSuccessfully") do task.wait(0.5) end
    while true do
        task.wait(AS_CHECK_INTERVAL)
        if AS_ENABLED then doSell(false) end
    end
end)

